generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SettingCategory {
  GENERAL
  SECURITY
  NOTIFICATION
  STORAGE
  APPLICATION
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum NotificationChannel {
  INTERNAL
  EMAIL
  SMS
  PUSH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum CatalogProductStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum BrandStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductSkuStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductAttributeValueType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DIMENSION
}

enum ProductSpecificationScope {
  PRODUCT
  VARIANT
}

enum ProductImportFormat {
  CSV
  XLSX
}

enum ProductImportStatus {
  UPLOADED
  VALIDATING
  READY
  APPLYING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ProductImportRowAction {
  CREATE
  UPDATE
  SKIP
}

enum ProductImportRowStatus {
  PENDING
  VALID
  VALIDATION_ERROR
  APPLIED
  FAILED
  ROLLED_BACK
}

enum ProductMediaRole {
  HERO
  GALLERY
  VIDEO
}

enum BranchKind {
  STORE
  CENTRAL_STOCK
}

enum BranchStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum InventoryLocationStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum InventoryLocationType {
  RECEIVING
  STORAGE
  PICKUP
  QUARANTINE
  DAMAGED
}

enum StockMovementType {
  PURCHASE
  TRANSFER
  ADJUSTMENT
  RETURN
  SALE_RESERVED
  SALE_FULFILLED
}

enum InventoryAdjustmentDirection {
  INCREASE
  DECREASE
}

enum DeviceUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  DAMAGED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CANCELLED
  FULFILLED
}

enum InventoryTrackingMode {
  NONE
  SERIAL
  IMEI
  SERIAL_AND_IMEI
}

enum StorefrontCartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum OrderSource {
  STOREFRONT
  ADMIN
  BRANCH_POS
  CALL_CENTER
  IMPORT
  API
}

enum OrderType {
  STANDARD_SALE
  PICKUP
  DELIVERY
  RESERVATION
  PREORDER
  INSTALLMENT_PLACEHOLDER
  TRADE_IN_PLACEHOLDER
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REJECTED
}

enum OrderPaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  INITIALIZING
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
}

enum PaymentAttemptStatus {
  CREATED
  INITIALIZING
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionType {
  INITIALIZATION
  AUTHORIZATION
  CAPTURE
  VERIFICATION
  REVERSAL
  REFUND
  RECONCILIATION
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentSignatureStatus {
  VALID
  INVALID
  NOT_PROVIDED
  UNSUPPORTED
}

enum PaymentCallbackProcessingStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

enum RefundStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentReconciliationDifferenceType {
  NONE
  INTERNAL_PAID_PROVIDER_NOT_PAID
  PROVIDER_PAID_INTERNAL_NOT_PAID
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  DUPLICATE_PROVIDER_REFERENCE
  MISSING_ORDER
  REFUND_MISMATCH
  UNPROCESSED_CALLBACK
}

enum PaymentReconciliationResolutionStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum PaymentEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum OrderAllocationStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  ALLOCATED
  ALLOCATION_FAILED
  RELEASED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  PENDING
  PICKING
  PACKED
  READY_FOR_PICKUP
  SHIPPED
  PARTIALLY_FULFILLED
  DELIVERED
  FAILED
  CANCELLED
}

enum OrderFulfillmentMethod {
  PICKUP
  DELIVERY
}

enum OrderNoteVisibility {
  INTERNAL
  CUSTOMER
}

enum OrderActorType {
  CUSTOMER
  ADMIN
  GUEST
  SYSTEM
}

enum OrderEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum OrderDeviceAssignmentStatus {
  RESERVED
  RELEASED
  FULFILLED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  image                 String?
  email                 String?                @unique
  emailVerified         DateTime?
  mobile                String?                @unique
  status                UserStatus             @default(ACTIVE)
  profile               UserProfile?
  adminProfile          AdminUser?
  addresses             Address[]
  roles                 UserRole[]
  sessions              Session[]
  accounts              Account[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  uploadedMedia         MediaFile[]            @relation("MediaUploader")
  notifications         Notification[]         @relation("NotificationRecipient")
  updatedSettings       SystemSetting[]        @relation("SettingUpdatedBy")
  settingVersions       SystemSettingVersion[] @relation("SettingVersionActor")
  storefrontCarts       StorefrontCart[]
  approvedProducts      CatalogProduct[]       @relation("ProductApprovedBy")
  productWorkflowEvents ProductWorkflowEvent[] @relation("ProductWorkflowActor")
  productImportBatches  ProductImportBatch[]   @relation("ProductImportRequestedBy")
  inventoryMovements    StockMovement[]        @relation("StockMovementActor")
  inventoryReservations InventoryReservation[] @relation("InventoryReservationCreator")
  orders                Order[]                @relation("OrderCustomer")
  orderStatusHistory    OrderStatusHistory[]   @relation("OrderStatusActor")
  orderNotes            OrderNote[]            @relation("OrderNoteAuthor")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  userId       String    @unique
  passwordHash String?
  branchId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchId, isActive])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  passwordHash     String?
  firstName        String?
  lastName         String?
  nationalCodeHash String?  @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  mobile        String
  province      String?
  city          String?
  line1         String
  postalCode    String?
  isDefault     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isSystem, name])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  group       String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([group, code])
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, expires])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model SystemSetting {
  id          String                 @id @default(cuid())
  key         String                 @unique
  category    SettingCategory
  value       Json
  isSensitive Boolean                @default(false)
  version     Int                    @default(1)
  updatedById String?
  updatedBy   User?                  @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions    SystemSettingVersion[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([category, key])
}

model SystemSettingVersion {
  id          String        @id @default(cuid())
  settingId   String
  version     Int
  value       Json
  changedById String?
  setting     SystemSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  changedBy   User?         @relation("SettingVersionActor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@unique([settingId, version])
  @@index([changedById, createdAt])
}

model MediaFile {
  id                String               @id @default(cuid())
  storageKey        String               @unique
  originalName      String
  contentType       String
  extension         String
  bytes             Int
  kind              MediaKind
  url               String?
  checksum          String?
  metadata          Json?
  uploadedById      String
  uploadedBy        User                 @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  productMedia      ProductMedia[]
  brandLogos        Brand[]              @relation("BrandLogoMedia")
  categoryImages    CatalogCategory[]    @relation("CategoryImageMedia")
  importSourceFiles ProductImportBatch[] @relation("ProductImportSourceFile")
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([uploadedById, createdAt])
  @@index([kind, deletedAt, createdAt])
}

model CatalogCategory {
  id                   String                       @id @default(cuid())
  parentId             String?
  imageMediaId         String?
  slug                 String                       @unique
  name                 String
  description          String?
  imageUrl             String?
  seoTitle             String?
  seoDescription       String?
  canonicalUrl         String?
  schemaData           Json?
  sortOrder            Int                          @default(0)
  isActive             Boolean                      @default(true)
  deletedAt            DateTime?
  parent               CatalogCategory?             @relation("CatalogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             CatalogCategory[]            @relation("CatalogCategoryTree")
  imageMedia           MediaFile?                   @relation("CategoryImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  products             CatalogProduct[]
  attributeAssignments CategoryAttribute[]
  specificationGroups  CategorySpecificationGroup[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder])
  @@index([deletedAt, isActive])
}

model CatalogProduct {
  id                       String                 @id @default(cuid())
  categoryId               String?
  brandId                  String?
  approvedById             String?
  slug                     String                 @unique
  name                     String
  brand                    String                 @default("Apple")
  summary                  String?
  description              String?
  status                   CatalogProductStatus   @default(DRAFT)
  specifications           Json?
  seoTitle                 String?
  seoDescription           String?
  submittedForReviewAt     DateTime?
  approvedAt               DateTime?
  publishedAt              DateTime?
  deletedAt                DateTime?
  version                  Int                    @default(1)
  searchText               String?
  isFeatured               Boolean                @default(false)
  featuredRank             Int?
  isNew                    Boolean                @default(false)
  isOnSale                 Boolean                @default(false)
  category                 CatalogCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandRecord              Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  approvedBy               User?                  @relation("ProductApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  variants                 CatalogVariant[]
  media                    ProductMedia[]
  seo                      ProductSeo?
  specificationsStructured ProductSpecification[]
  workflowEvents           ProductWorkflowEvent[]
  orderItems               OrderItem[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([isFeatured, status])
  @@index([brandId, status, publishedAt])
  @@index([deletedAt, status, updatedAt])
}

model CatalogVariant {
  id                       String                 @id @default(cuid())
  productId                String
  warrantyId               String?
  sku                      String                 @unique
  title                    String?
  color                    String?
  storage                  String?
  region                   String?
  modelNumber              String?
  optionKey                String?
  warranty                 String?
  attributes               Json?
  priceRials               BigInt
  compareAtPriceRials      BigInt?
  isActive                 Boolean                @default(true)
  deletedAt                DateTime?
  version                  Int                    @default(1)
  sortOrder                Int                    @default(0)
  product                  CatalogProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warrantyRecord           Warranty?              @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  inventory                BranchInventory[]
  cartItems                StorefrontCartItem[]
  skuRecord                ProductSku?
  specificationsStructured ProductSpecification[]
  media                    ProductMedia[]
  orderItems               OrderItem[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([productId, isActive, sortOrder])
  @@index([isActive, priceRials])
  @@index([warrantyId, isActive])
  @@index([productId, optionKey])
  @@index([deletedAt, isActive])
}

model ProductMedia {
  productId String
  mediaId   String
  variantId String?
  id        String           @unique @default(cuid())
  role      ProductMediaRole @default(GALLERY)
  altText   String?
  caption   String?
  sortOrder Int              @default(0)
  product   CatalogProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   CatalogVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  media     MediaFile        @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@id([productId, mediaId])
  @@index([mediaId])
  @@index([productId, role, sortOrder])
  @@index([variantId, sortOrder])
}

model Brand {
  id             String           @id @default(cuid())
  code           String           @unique
  slug           String           @unique
  name           String
  logoMediaId    String?
  description    String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  schemaData     Json?
  status         BrandStatus      @default(DRAFT)
  deletedAt      DateTime?
  logoMedia      MediaFile?       @relation("BrandLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  products       CatalogProduct[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, name])
  @@index([deletedAt, status])
}

model Warranty {
  id             String           @id @default(cuid())
  code           String           @unique
  provider       String
  name           String
  durationMonths Int
  terms          String?          @db.Text
  conditions     String?          @db.Text
  isActive       Boolean          @default(true)
  deletedAt      DateTime?
  variants       CatalogVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([provider, isActive])
  @@index([deletedAt, isActive])
}

model ProductSku {
  id                  String              @id @default(cuid())
  variantId           String              @unique
  code                String              @unique
  barcode             String?             @unique
  priceRials          BigInt
  compareAtPriceRials BigInt?
  costRials           BigInt?
  status              ProductSkuStatus    @default(ACTIVE)
  version             Int                 @default(1)
  deletedAt           DateTime?
  variant             CatalogVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryPolicy     InventorySkuPolicy?
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  deviceUnits         DeviceUnit[]
  orderItems          OrderItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, updatedAt])
  @@index([deletedAt, status])
}

model SpecificationGroup {
  id                 String                       @id @default(cuid())
  code               String                       @unique
  name               String
  description        String?
  sortOrder          Int                          @default(0)
  isActive           Boolean                      @default(true)
  deletedAt          DateTime?
  attributes         ProductAttribute[]
  categories         CategorySpecificationGroup[]
  categoryAttributes CategoryAttribute[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([isActive, sortOrder])
  @@index([deletedAt, isActive])
}

model ProductAttribute {
  id                  String                    @id @default(cuid())
  groupId             String?
  code                String                    @unique
  name                String
  valueType           ProductAttributeValueType
  unitCode            String?
  description         String?
  isFilterable        Boolean                   @default(false)
  isSearchable        Boolean                   @default(true)
  isRequiredDefault   Boolean                   @default(false)
  sortOrder           Int                       @default(0)
  isActive            Boolean                   @default(true)
  deletedAt           DateTime?
  group               SpecificationGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  values              AttributeValue[]
  categoryAssignments CategoryAttribute[]
  specifications      ProductSpecification[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([groupId, isActive, sortOrder])
  @@index([deletedAt, isActive])
}

model AttributeValue {
  id             String                 @id @default(cuid())
  attributeId    String
  code           String
  label          String
  sortOrder      Int                    @default(0)
  isActive       Boolean                @default(true)
  metadata       Json?
  deletedAt      DateTime?
  attribute      ProductAttribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  specifications ProductSpecification[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([attributeId, code])
  @@index([attributeId, isActive, sortOrder])
  @@index([deletedAt, isActive])
}

model CategorySpecificationGroup {
  id         String             @id @default(cuid())
  categoryId String
  groupId    String
  sortOrder  Int                @default(0)
  category   CatalogCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group      SpecificationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([categoryId, groupId])
  @@index([groupId, sortOrder])
}

model CategoryAttribute {
  id           String              @id @default(cuid())
  categoryId   String
  attributeId  String
  groupId      String?
  isRequired   Boolean             @default(false)
  isFilterable Boolean             @default(false)
  sortOrder    Int                 @default(0)
  category     CatalogCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute    ProductAttribute    @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  group        SpecificationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([categoryId, attributeId])
  @@index([groupId, sortOrder])
}

model ProductSpecification {
  id               String                    @id @default(cuid())
  productId        String
  variantId        String?
  attributeId      String
  attributeValueId String?
  scope            ProductSpecificationScope
  subjectKey       String
  value            Json?
  displayValue     String
  unitCode         String?
  sortOrder        Int                       @default(0)
  product          CatalogProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          CatalogVariant?           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute        ProductAttribute          @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue   AttributeValue?           @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([productId, subjectKey, attributeId])
  @@index([variantId, sortOrder])
  @@index([attributeId, attributeValueId])
}

model ProductSeo {
  id              String         @id @default(cuid())
  productId       String         @unique
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  schemaData      Json?
  noIndex         Boolean        @default(false)
  product         CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductWorkflowEvent {
  id         String               @id @default(cuid())
  productId  String
  actorId    String?
  fromStatus CatalogProductStatus
  toStatus   CatalogProductStatus
  note       String?
  revision   Int
  product    CatalogProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor      User?                @relation("ProductWorkflowActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([productId, createdAt])
  @@index([actorId, createdAt])
}

model ProductImportBatch {
  id                String                @id @default(cuid())
  sourceFileId      String?
  requestedById     String?
  format            ProductImportFormat
  status            ProductImportStatus   @default(UPLOADED)
  originalFileName  String
  sourceChecksum    String?
  mappingVersion    String                @default("v1")
  totalRows         Int                   @default(0)
  validRows         Int                   @default(0)
  failedRows        Int                   @default(0)
  validationSummary Json?
  errorReport       Json?
  applyAttemptToken String?
  applyStartedAt    DateTime?
  appliedAt         DateTime?
  rolledBackAt      DateTime?
  sourceFile        MediaFile?            @relation("ProductImportSourceFile", fields: [sourceFileId], references: [id], onDelete: SetNull)
  requestedBy       User?                 @relation("ProductImportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  rows              ProductImportRow[]
  changes           ProductImportChange[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([status, applyStartedAt])
  @@index([requestedById, createdAt])
  @@index([sourceChecksum])
}

model ProductImportRow {
  id               String                 @id @default(cuid())
  importBatchId    String
  rowNumber        Int
  status           ProductImportRowStatus @default(PENDING)
  action           ProductImportRowAction @default(SKIP)
  rawData          Json
  normalizedData   Json?
  validationErrors Json?
  appliedAt        DateTime?
  importBatch      ProductImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status, rowNumber])
}

model ProductImportChange {
  id             String                 @id @default(cuid())
  importBatchId  String
  entityType     String
  entityId       String
  action         ProductImportRowAction
  beforeSnapshot Json?
  afterSnapshot  Json?
  importBatch    ProductImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([importBatchId, entityType])
}

model Branch {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  kind              BranchKind         @default(STORE)
  status            BranchStatus       @default(ACTIVE)
  city              String?
  address           String?
  phone             String?
  isActive          Boolean            @default(true)
  isPickupEnabled   Boolean            @default(true)
  inventory         BranchInventory[]
  warehouses        Warehouse[]
  orderAllocations  OrderAllocation[]
  orderFulfillments OrderFulfillment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([isActive, kind])
  @@index([status, kind])
}

model BranchInventory {
  branchId  String
  variantId String
  onHand    Int            @default(0)
  reserved  Int            @default(0)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant   CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt DateTime       @updatedAt

  @@id([branchId, variantId])
  @@index([variantId])
}

model Warehouse {
  id                String              @id @default(cuid())
  branchId          String
  code              String
  name              String
  status            WarehouseStatus     @default(ACTIVE)
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locations         InventoryLocation[]
  orderAllocations  OrderAllocation[]
  orderFulfillments OrderFulfillment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([branchId, code])
  @@index([branchId, status])
}

model InventoryLocation {
  id                String                  @id @default(cuid())
  warehouseId       String
  code              String
  name              String
  type              InventoryLocationType
  status            InventoryLocationStatus @default(ACTIVE)
  warehouse         Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryItems    InventoryItem[]         @relation("InventoryItemLocation")
  outgoingMovements StockMovement[]         @relation("StockMovementFromLocation")
  incomingMovements StockMovement[]         @relation("StockMovementToLocation")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([warehouseId, code])
  @@unique([id, warehouseId])
  @@index([warehouseId, status, type])
}

model InventorySkuPolicy {
  id           String                @id @default(cuid())
  skuId        String                @unique
  trackingMode InventoryTrackingMode @default(NONE)
  sku          ProductSku            @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model InventoryItem {
  id                String                 @id @default(cuid())
  warehouseId       String
  locationId        String
  skuId             String
  quantity          Int                    @default(0)
  reservedQuantity  Int                    @default(0)
  availableQuantity Int                    @default(0)
  version           Int                    @default(1)
  location          InventoryLocation      @relation("InventoryItemLocation", fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict)
  sku               ProductSku             @relation(fields: [skuId], references: [id], onDelete: Restrict)
  deviceUnits       DeviceUnit[]
  reservations      InventoryReservation[]
  orderAllocations  OrderAllocation[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([locationId, skuId])
  @@index([warehouseId, skuId])
  @@index([skuId, availableQuantity])
}

model StockMovement {
  id                  String                        @id @default(cuid())
  skuId               String
  fromLocationId      String?
  toLocationId        String?
  quantity            Int
  type                StockMovementType
  adjustmentDirection InventoryAdjustmentDirection?
  reference           String?
  idempotencyKey      String                        @unique
  performedById       String?
  metadata            Json?
  sku                 ProductSku                    @relation(fields: [skuId], references: [id], onDelete: Restrict)
  fromLocation        InventoryLocation?            @relation("StockMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation          InventoryLocation?            @relation("StockMovementToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  performedBy         User?                         @relation("StockMovementActor", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt           DateTime                      @default(now())

  @@index([skuId, createdAt])
  @@index([fromLocationId, createdAt])
  @@index([toLocationId, createdAt])
  @@index([reference, createdAt])
}

model DeviceUnit {
  id                String                  @id @default(cuid())
  skuId             String
  inventoryItemId   String?
  reservationId     String?
  imei              String?                 @unique
  serialNumber      String?                 @unique
  status            DeviceUnitStatus        @default(AVAILABLE)
  warrantyExpiresAt DateTime?
  metadata          Json?
  sku               ProductSku              @relation(fields: [skuId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem?          @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  reservation       InventoryReservation?   @relation("InventoryReservationDeviceUnits", fields: [reservationId], references: [id], onDelete: Restrict)
  orderAssignments  OrderDeviceAssignment[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([skuId, status])
  @@index([inventoryItemId, status])
  @@index([reservationId, status])
}

model InventoryReservation {
  id                     String                     @id @default(cuid())
  inventoryItemId        String
  quantity               Int
  status                 InventoryReservationStatus @default(ACTIVE)
  expiresAt              DateTime?
  reference              String?
  idempotencyKey         String                     @unique
  createdById            String?
  inventoryItem          InventoryItem              @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy              User?                      @relation("InventoryReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deviceUnits            DeviceUnit[]               @relation("InventoryReservationDeviceUnits")
  orderAllocations       OrderAllocation[]
  orderDeviceAssignments OrderDeviceAssignment[]    @relation("OrderDeviceAssignmentReservation")
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([inventoryItemId, status, expiresAt])
  @@index([reference, status])
}

model StorefrontCart {
  id             String               @id @default(cuid())
  userId         String?
  guestTokenHash String?              @unique
  status         StorefrontCartStatus @default(ACTIVE)
  currency       String               @default("IRR")
  version        Int                  @default(1)
  expiresAt      DateTime?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          StorefrontCartItem[]
  sourceOrder    Order?               @relation("OrderSourceCart")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, status, updatedAt])
  @@index([status, expiresAt])
}

model StorefrontCartItem {
  cartId         String
  variantId      String
  quantity       Int            @default(1)
  unitPriceRials BigInt?
  cart           StorefrontCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant        CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@id([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                      String                   @id @default(cuid())
  orderNumber             String                   @unique
  source                  OrderSource
  type                    OrderType
  customerId              String?
  sourceCartId            String?                  @unique
  guestTokenHash          String?
  customerSnapshot        Json
  billingAddressSnapshot  Json?
  shippingAddressSnapshot Json?
  currency                String                   @default("IRR")
  subtotalRials           BigInt
  discountTotalRials      BigInt                   @default(0)
  taxTotalRials           BigInt                   @default(0)
  shippingTotalRials      BigInt                   @default(0)
  feeTotalRials           BigInt                   @default(0)
  grandTotalRials         BigInt
  paymentStatus           OrderPaymentStatus       @default(UNPAID)
  fulfillmentStatus       OrderFulfillmentStatus   @default(UNFULFILLED)
  fulfillmentMethod       OrderFulfillmentMethod
  orderStatus             OrderStatus              @default(DRAFT)
  allocationStatus        OrderAllocationStatus    @default(UNALLOCATED)
  version                 Int                      @default(1)
  customer                User?                    @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  sourceCart              StorefrontCart?          @relation("OrderSourceCart", fields: [sourceCartId], references: [id], onDelete: Restrict)
  items                   OrderItem[]
  allocations             OrderAllocation[]
  payments                OrderPayment[]
  canonicalPayment        Payment?                 @relation("CanonicalOrderPayment")
  fulfillment             OrderFulfillment?
  statusHistory           OrderStatusHistory[]
  notes                   OrderNote[]
  idempotencyRecords      OrderIdempotencyRecord[]
  outboxEvents            OrderOutboxEvent[]
  deviceAssignments       OrderDeviceAssignment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([customerId, createdAt])
  @@index([guestTokenHash, createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model OrderItem {
  id                  String                  @id @default(cuid())
  orderId             String
  productId           String
  variantId           String
  productSkuId        String
  sku                 String
  productName         String
  variantName         String?
  quantity            Int
  unitPriceRials      BigInt
  discountAmountRials BigInt                  @default(0)
  taxAmountRials      BigInt                  @default(0)
  lineTotalRials      BigInt
  warrantySnapshot    Json?
  attributesSnapshot  Json?
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             CatalogProduct          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant             CatalogVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productSku          ProductSku              @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  allocations         OrderAllocation[]
  deviceAssignments   OrderDeviceAssignment[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([orderId, createdAt])
  @@index([variantId])
  @@index([productSkuId])
}

model OrderAllocation {
  id                String                  @id @default(cuid())
  orderId           String
  orderItemId       String
  branchId          String
  warehouseId       String
  inventoryItemId   String
  reservationId     String?                 @unique
  quantity          Int
  status            OrderAllocationStatus   @default(UNALLOCATED)
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem         OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  branch            Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse         Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  reservation       InventoryReservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  deviceAssignments OrderDeviceAssignment[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([orderId, status])
  @@index([orderItemId, status])
  @@index([branchId, status])
  @@index([warehouseId, status])
  @@index([inventoryItemId, status])
}

/**
 * Immutable OMS evidence for a tracked device selected by a reservation.
 * The active-device partial unique index in the migration prevents two live
 * order allocations from claiming the same IMEI/serial unit while allowing a
 * released unit to be assigned to a later order.
 */
model OrderDeviceAssignment {
  id                   String                      @id @default(cuid())
  orderId              String
  orderItemId          String
  orderAllocationId    String
  deviceUnitId         String
  reservationId        String
  imeiSnapshot         String?
  serialNumberSnapshot String?
  status               OrderDeviceAssignmentStatus @default(RESERVED)
  releasedAt           DateTime?
  fulfilledAt          DateTime?
  order                Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem            OrderItem                   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  allocation           OrderAllocation             @relation(fields: [orderAllocationId], references: [id], onDelete: Cascade)
  deviceUnit           DeviceUnit                  @relation(fields: [deviceUnitId], references: [id], onDelete: Restrict)
  reservation          InventoryReservation        @relation("OrderDeviceAssignmentReservation", fields: [reservationId], references: [id], onDelete: Restrict)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([orderAllocationId, deviceUnitId])
  @@index([orderId, status])
  @@index([orderItemId, status])
  @@index([deviceUnitId, status])
  @@index([reservationId, status])
}

model OrderPayment {
  id                String             @id @default(cuid())
  orderId           String
  provider          String
  method            String
  amountRials       BigInt
  status            OrderPaymentStatus @default(UNPAID)
  idempotencyKey    String
  providerReference String?            @unique
  metadata          Json?
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([orderId, idempotencyKey])
  @@index([orderId, status, createdAt])
  @@index([status, createdAt])
}

/**
 * Canonical Phase 08 payment aggregate. The amount and currency are copied
 * only from the persisted Order commercial snapshot and never from a browser.
 */
model Payment {
  id                    String                        @id @default(cuid())
  orderId               String                        @unique
  paymentNumber         String                        @unique
  currency              String                        @default("IRR") @db.VarChar(3)
  amountRials           BigInt
  status                PaymentStatus                 @default(CREATED)
  method                PaymentMethod                 @default(ONLINE)
  provider              String                        @db.VarChar(64)
  version               Int                           @default(1)
  paidAt                DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  expiresAt             DateTime?
  order                 Order                         @relation("CanonicalOrderPayment", fields: [orderId], references: [id], onDelete: Restrict)
  attempts              PaymentAttempt[]
  transactions          PaymentTransaction[]
  callbacks             PaymentCallback[]
  refunds               Refund[]
  reconciliationRecords PaymentReconciliationRecord[]
  idempotencyRecords    PaymentIdempotencyRecord[]
  outboxEvents          PaymentOutboxEvent[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([status, createdAt])
  @@index([provider, status, createdAt])
  @@index([createdAt])
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  paymentId         String
  attemptNumber     Int
  provider          String               @db.VarChar(64)
  amountRials       BigInt
  currency          String               @db.VarChar(3)
  status            PaymentAttemptStatus @default(CREATED)
  idempotencyKey    String               @db.VarChar(160)
  providerAuthority String?              @db.VarChar(200)
  providerReference String?              @db.VarChar(200)
  redirectUrl       String?              @db.Text
  providerStatus    String?              @db.VarChar(80)
  failureCode       String?              @db.VarChar(120)
  expiresAt         DateTime?
  completedAt       DateTime?
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transactions      PaymentTransaction[]
  callbacks         PaymentCallback[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([paymentId, attemptNumber])
  @@unique([paymentId, idempotencyKey])
  @@unique([provider, providerAuthority])
  @@unique([provider, providerReference])
  @@index([paymentId, createdAt])
  @@index([status, expiresAt])
}

/**
 * Append-only provider interaction evidence.
 */
model PaymentTransaction {
  id                String                   @id @default(cuid())
  paymentId         String
  attemptId         String?
  type              PaymentTransactionType
  amountRials       BigInt
  status            PaymentTransactionStatus
  providerReference String?                  @db.VarChar(200)
  providerCode      String?                  @db.VarChar(120)
  safeMetadata      Json?
  occurredAt        DateTime                 @default(now())
  payment           Payment                  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attempt           PaymentAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())

  @@index([paymentId, type, providerReference])
  @@index([paymentId, occurredAt])
  @@index([attemptId, occurredAt])
  @@index([type, status, occurredAt])
}

model PaymentCallback {
  id               String                          @id @default(cuid())
  provider         String                          @db.VarChar(64)
  externalEventId  String                          @db.VarChar(200)
  payloadHash      String                          @db.Char(64)
  signatureStatus  PaymentSignatureStatus
  processingStatus PaymentCallbackProcessingStatus @default(RECEIVED)
  paymentId        String?
  attemptId        String?
  failureCode      String?                         @db.VarChar(120)
  receivedAt       DateTime                        @default(now())
  processedAt      DateTime?
  payment          Payment?                        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  attempt          PaymentAttempt?                 @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@unique([provider, externalEventId])
  @@index([paymentId, receivedAt])
  @@index([attemptId, receivedAt])
  @@index([processingStatus, receivedAt])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  amountRials       BigInt
  reason            String       @db.Text
  status            RefundStatus @default(CREATED)
  idempotencyKey    String       @db.VarChar(160)
  providerReference String?      @unique @db.VarChar(200)
  failureCode       String?      @db.VarChar(120)
  completedAt       DateTime?
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([paymentId, idempotencyKey])
  @@index([paymentId, status])
  @@index([status, createdAt])
}

model PaymentReconciliationRecord {
  id               String                                @id @default(cuid())
  paymentId        String
  internalStatus   String                                @db.VarChar(80)
  providerStatus   String                                @db.VarChar(80)
  differenceType   PaymentReconciliationDifferenceType
  resolutionStatus PaymentReconciliationResolutionStatus @default(OPEN)
  safeDetails      Json?
  checkedAt        DateTime                              @default(now())
  payment          Payment                               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt        DateTime                              @default(now())
  updatedAt        DateTime                              @updatedAt

  @@index([paymentId, checkedAt])
  @@index([resolutionStatus, checkedAt])
  @@index([differenceType, checkedAt])
}

model PaymentIdempotencyRecord {
  id                String   @id @default(cuid())
  scope             String   @db.VarChar(240)
  key               String   @db.VarChar(160)
  requestHash       String   @db.Char(64)
  responseReference String   @db.VarChar(240)
  paymentId         String?
  expiresAt         DateTime
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([scope, key])
  @@index([paymentId])
  @@index([expiresAt])
}

model PaymentOutboxEvent {
  id               String             @id @default(cuid())
  paymentId        String
  eventType        String             @db.VarChar(120)
  aggregateVersion Int
  schemaVersion    Int                @default(1)
  payload          Json
  occurredAt       DateTime           @default(now())
  status           PaymentEventStatus @default(PENDING)
  availableAt      DateTime           @default(now())
  attempts         Int                @default(0)
  publishedAt      DateTime?
  lastError        String?            @db.Text
  payment          Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([paymentId, eventType, aggregateVersion])
  @@index([status, availableAt])
  @@index([paymentId, occurredAt])
}

model OrderFulfillment {
  id           String                 @id @default(cuid())
  orderId      String                 @unique
  method       OrderFulfillmentMethod
  branchId     String?
  warehouseId  String?
  status       OrderFulfillmentStatus @default(PENDING)
  trackingCode String?
  preparedAt   DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch       Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([branchId, status])
  @@index([warehouseId, status])
  @@index([status, createdAt])
}

model OrderStatusHistory {
  id         String         @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actorType  OrderActorType
  reasonCode String?
  note       String?        @db.Text
  requestId  String
  version    Int
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?          @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@index([requestId])
}

model OrderNote {
  id         String              @id @default(cuid())
  orderId    String
  visibility OrderNoteVisibility @default(INTERNAL)
  content    String              @db.Text
  authorId   String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User                @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([orderId, visibility, createdAt])
  @@index([authorId, createdAt])
}

model OrderIdempotencyRecord {
  id                String   @id @default(cuid())
  scope             String
  key               String
  requestHash       String
  responseReference String
  orderId           String?
  expiresAt         DateTime
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
  @@index([orderId])
}

model OrderOutboxEvent {
  id               String           @id @default(cuid())
  orderId          String
  eventType        String
  aggregateVersion Int
  schemaVersion    Int              @default(1)
  payload          Json
  /**
   * Domain occurrence time is distinct from persistence/update bookkeeping.
   */
  occurredAt       DateTime         @default(now())
  status           OrderEventStatus @default(PENDING)
  availableAt      DateTime         @default(now())
  attempts         Int              @default(0)
  publishedAt      DateTime?
  lastError        String?          @db.Text
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([orderId, eventType, aggregateVersion])
  @@index([status, availableAt])
  @@index([orderId, occurredAt])
}

model Notification {
  id          String               @id @default(cuid())
  recipientId String
  channel     NotificationChannel  @default(INTERNAL)
  priority    NotificationPriority @default(NORMAL)
  status      NotificationStatus   @default(PENDING)
  category    String
  title       String
  body        String
  actionUrl   String?
  metadata    Json?
  readAt      DateTime?
  recipient   User                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([recipientId, status, createdAt])
  @@index([category, priority, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorType      String?
  action         String
  entityType     String
  entityId       String?
  requestId      String
  reasonCode     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  beforeSnapshot Json?
  afterSnapshot  Json?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, entityType, createdAt])
  @@index([requestId])
}
