# Local/disposable Phase 06 inventory database only. Copy to
# .env.inventory-test; never commit the copied file.
# The preflight validates every identity field without opening a connection.
NODE_ENV=test
# Required acknowledgement for every Phase 06.1 database command.
APPLE333_TEST_DB=1

# Docker Compose pins the database and role to apple333_phase06_test. Only the
# disposable local password is configurable; never use a shared credential.
INVENTORY_TEST_POSTGRES_PASSWORD=local-test-only-change-me

# Must exactly target the Compose-pinned database and role through literal IPv4
# loopback on the dedicated non-default port 55433 with schema=public.
# URL-encode reserved password characters.
INVENTORY_TEST_DATABASE_URL=postgresql://apple333_phase06_test:local-test-only-change-me@127.0.0.1:55433/apple333_phase06_test?schema=public

# Disposable Redis for Phase 06.1 production-runtime/E2E evidence only. It is
# loopback-only, has no persistence volume, and must never be a shared Redis.
INVENTORY_TEST_REDIS_URL=redis://127.0.0.1:56379
