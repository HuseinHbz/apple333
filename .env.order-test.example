# Local/disposable Phase 07 order-management database only. Copy to
# .env.order-test; never commit the copied file.
#
# Every Phase 07 database command validates these exact markers and the target
# identity before importing Prisma or opening a connection.
NODE_ENV=test
APPLE333_TEST_DB=1
APPLE333_ORDER_TEST_DB=1
# Required only by the production-artifact Playwright harness. It is paired
# with APPLE333_E2E_RUNTIME_EVIDENCE internally so production cookies stay
# Secure everywhere outside this disposable loopback runtime.
APPLE333_ORDER_E2E_TEST_DB=1

# These identities are fixed by docker-compose.order-test.yml. The password is
# deliberately disposable and must never be reused for development, staging,
# or production.
ORDER_TEST_POSTGRES_DB=apple333_phase07_order_test
ORDER_TEST_POSTGRES_USER=apple333_phase07_order_test
ORDER_TEST_POSTGRES_PASSWORD=local-test-only-change-me
ORDER_TEST_POSTGRES_BIND=127.0.0.1
ORDER_TEST_POSTGRES_PORT=55434

# Must exactly target the pinned local database and role through literal IPv4
# loopback on the dedicated Phase 07 port with schema=public. URL-encode any
# reserved password characters. Do not set DATABASE_URL in this file; guarded
# scripts set it only for their child process after the preflight succeeds.
ORDER_TEST_DATABASE_URL=postgresql://apple333_phase07_order_test:local-test-only-change-me@127.0.0.1:55434/apple333_phase07_order_test?schema=public
