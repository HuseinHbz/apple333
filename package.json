{
  "name": "apple333-enterprise-platform",
  "version": "2.0.0-alpha.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepare:standalone": "node scripts/prepare-standalone-runtime.mjs",
    "start": "pnpm prepare:standalone && node .next/standalone/server.js",
    "start:standalone": "pnpm prepare:standalone && node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:standard": "playwright test --grep-invert=\"Phase (?:06 inventory and multi-branch|07 order-management|08 payment) browser journeys\"",
    "test:deploy": "vitest run tests/unit/deploy-assets.test.ts",
    "pim:test:preflight": "node scripts/verify-pim-test-environment.mjs",
    "pim:test:migrate": "node scripts/run-pim-test-migrations.mjs",
    "test:pim-db": "node scripts/run-pim-database-tests.mjs",
    "pim:benchmark": "node scripts/benchmark-pim-catalog.mjs",
    "inventory:test:preflight": "node scripts/verify-inventory-test-environment.mjs",
    "inventory:test:migrate": "node scripts/run-inventory-test-migrations.mjs",
    "test:inventory-db": "node scripts/run-inventory-database-tests.mjs",
    "inventory:e2e:seed": "node scripts/seed-e2e-inventory.mjs",
    "test:e2e:inventory": "node scripts/run-inventory-e2e-tests.mjs",
    "inventory:benchmark": "node scripts/benchmark-inventory.mjs --help",
    "inventory:reconcile": "node scripts/reconcile-branch-inventory.mjs --fail-on-drift",
    "inventory:test:cleanup": "node scripts/cleanup-phase06-test-environment.mjs --dry-run",
    "typecheck:phase-06-tests": "tsc --project tsconfig.phase06-tests.json",
    "order:test:preflight": "node scripts/verify-order-test-environment.mjs",
    "order:test:migrate": "node scripts/run-order-test-migrations.mjs",
    "order:test:seed": "node scripts/seed-e2e-orders.mjs",
    "test:order-db": "node scripts/run-order-database-tests.mjs",
    "test:e2e:orders": "node scripts/run-order-e2e-tests.mjs",
    "order:benchmark": "node scripts/benchmark-orders.mjs",
    "order:reconcile": "node scripts/reconcile-orders.mjs --fail-on-drift",
    "order:test:cleanup": "node scripts/cleanup-phase07-test-environment.mjs",
    "order:evidence:metadata": "node scripts/write-order-evidence-metadata.mjs",
    "typecheck:phase-07-tests": "tsc --project tsconfig.phase07-tests.json",
    "payment:test:preflight": "node --env-file-if-exists=.env.payment-test scripts/verify-payment-test-environment.mjs",
    "payment:test:migrate": "node --env-file-if-exists=.env.payment-test scripts/run-payment-test-migrations.mjs",
    "payment:test:seed": "node --env-file-if-exists=.env.payment-test scripts/seed-payment-tests.mjs",
    "test:payment-db": "node --env-file-if-exists=.env.payment-test scripts/run-payment-database-tests.mjs",
    "test:e2e:payments": "node --env-file-if-exists=.env.payment-test scripts/run-payment-e2e-tests.mjs",
    "payment:benchmark": "node --env-file-if-exists=.env.payment-test scripts/benchmark-payments.mjs",
    "payment:reconcile": "node --env-file-if-exists=.env.payment-test scripts/reconcile-payments.mjs",
    "payment:test:cleanup": "node --env-file-if-exists=.env.payment-test scripts/cleanup-phase08-test-environment.mjs --dry-run",
    "typecheck:phase-08-tests": "tsc --project tsconfig.phase08-tests.json",
    "prompt:validate": "tsc --project tsconfig.prompt-validator.json && node .prompt-validator/scripts/validate-enterprise-prompts.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.7.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@sentry/nextjs": "10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "15.5.21",
    "next-auth": "4.24.15",
    "prom-client": "15.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "4.7.0",
    "zod": "3.24.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "ajv": "8.20.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.25.1",
    "eslint-config-next": "15.5.21",
    "jsdom": "26.1.0",
    "lighthouse": "^12.8.2",
    "postcss": "8.5.23",
    "prettier": "3.5.3",
    "prisma": "6.7.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  },
  "pnpm": {
    "overrides": {
      "@auth/core": "0.41.3",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "nanoid": "3.3.17",
      "sharp": "0.35.0",
      "postcss": "8.5.23"
    }
  }
}
